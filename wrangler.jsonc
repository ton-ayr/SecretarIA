{
  // Worker público (bot). O painel é outro Worker (wrangler.admin.jsonc).
  // O repositório é público: IDs da conta e endereços ficam no .dev.vars e vão
  // junto em npm run deploy:bot. O banco é achado pelo nome.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "secretaria-bot",
  "main": "src/bot/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "secretaria",
      "migrations_dir": "migrations"
    }
  ],
  // Um objeto por conversa (número da empresa + cliente). No plano grátis,
  // só Durable Objects com SQLite (ARQUITETURA §16).
  "durable_objects": {
    "bindings": [
      { "name": "CONVERSATION", "class_name": "ConversationDO" },
      { "name": "TEST_CHAT", "class_name": "TestChatDO" }
    ]
  },
  "exports": {
    "ConversationDO": { "type": "durable-object", "storage": "sqlite" },
    "TestChatDO": { "type": "durable-object", "storage": "sqlite" }
  },
  "triggers": {
    // Limpeza LGPD diária às 06:00 UTC (03:00 em Brasília).
    "crons": ["0 6 * * *", "17 * * * *", "*/15 * * * *"]
  },
  "vars": {
    // Ordem da cadeia de reserva: provedor:modelo, separados por vírgula.
    "LLM_CHAIN": "groq:openai/gpt-oss-120b,groq:openai/gpt-oss-20b,workersai:@cf/openai/gpt-oss-120b",
    "GROQ_BASE_URL": "https://api.groq.com/openai/v1",
    // {account_id} é trocado pelo valor de WORKERSAI_ACCOUNT_ID.
    "WORKERSAI_BASE_URL": "https://api.cloudflare.com/client/v4/accounts/{account_id}/ai/v1",
    // Limites diários do plano grátis, usados no alerta de 70%.
    "LLM_DAILY_LIMITS": "{\"groq:openai/gpt-oss-120b\":{\"requests\":1000,\"tokens\":200000},\"groq:openai/gpt-oss-20b\":{\"requests\":1000,\"tokens\":200000}}",
    // Versão da Graph API (v26.0 não mudou nada do WhatsApp; ARQUITETURA §16).
    "GRAPH_API_VERSION": "v26.0",
    // Transcrição de áudio: provedor:modelo, na ordem de reserva.
    "STT_CHAIN": "groq:whisper-large-v3-turbo,workersai:@cf/openai/whisper-large-v3-turbo",
    // Agrupamento: espera 5 s depois da última mensagem, no máximo 20 s.
    "GROUPING_DEBOUNCE_MS": "5000",
    "GROUPING_MAX_WAIT_MS": "20000",
    "RATE_LIMIT_PER_HOUR": "30",
    "REMINDER_TEMPLATE": "",
    "META_BILLED_ALERT": "800"
  }
}
