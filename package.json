{
  "name": "secretaria",
  "version": "0.1.0",
  "private": true,
  "license": "FSL-1.1-MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:public": "tsx scripts/check-public.ts",
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "sim": "tsx scripts/sim.ts",
    "evals": "tsx evals/run.ts",
    "secrets": "tsx scripts/secrets.ts",
    "meta": "tsx scripts/meta.ts",
    "webhook:local": "tsx scripts/webhook-local.ts",
    "db:migrate:local": "wrangler d1 migrations apply secretaria --local",
    "db:migrate:remote": "wrangler d1 migrations apply secretaria --remote",
    "db:seed:local": "wrangler d1 execute secretaria --local --file=seed/seed.sql",
    "db:seed:remote": "wrangler d1 execute secretaria --remote --file=seed/seed.sql",
    "dev:bot": "wrangler dev --var WHATSAPP_DRY_RUN:1",
    "deploy:bot": "tsx scripts/deploy.ts bot",
    "telegram": "tsx scripts/telegram.ts",
    "google": "tsx scripts/google.ts",
    "dev:admin": "wrangler dev -c wrangler.admin.jsonc -c wrangler.jsonc --var ADMIN_EMAILS:operador@local.test",
    "deploy:admin": "tsx scripts/deploy.ts admin",
    "lgpd:apagar": "tsx scripts/lgpd.ts apagar"
  },
  "dependencies": {
    "hono": "^4.13.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261002.1",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.147.0"
  }
}
